      "min": 280,
      "max": 720,
      "step": 10,
      "unit": "px",
      "label": "Bar max width",
      "default": 420
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Bar corner radius",
      "default": 10
