      "unit": "px",
      "label": "Gap between text and timer",
      "default": 12
    },
    {
      "type": "range",
      "id": "bar_margin_y",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bar vertical margin",
      "default": 10
    },
    {
      "type": "range",
      "id": "bar_padding_x",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Bar horizontal padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "bar_padding_y",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Bar vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "countdown_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Countdown font size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "countdown_font_size_mobile",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Countdown font size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "countdown_min_width",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Countdown min width (desktop)",
      "default": 62
    },
    {
      "type": "range",
      "id": "countdown_min_width_mobile",
      "min": 48,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Countdown min width (mobile)",
      "default": 58
    },
    {
      "type": "range",
      "id": "countdown_height",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Countdown height (desktop)",
      "default": 30
    },
    {
      "type": "range",
      "id": "countdown_height_mobile",
      "min": 24,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Countdown height (mobile)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
