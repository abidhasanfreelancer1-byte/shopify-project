ont-weight:600;\n  color:#fff;\n  font-family:'Brush Script MT', cursive;\n  letter-spacing:1px;\n  margin-top:0;\n  margin-bottom:2px;\n  transition:0.4s ease;\n  line-height:1;\n  animation:brandDrop 1.2s ease;\n}\n\n.brand-text:hover{\n  transform:scale(1.03) rotate(-2deg);\n  color:#f5f5f5;\n}\n\n/* ===== BRAND ANIMATION ===== */\n\n@keyframes brandDrop{\n\n  0%{\n    opacity:0;\n    transform:translateY(-35px);\n  }\n\n  100%{\n    opacity:1;\n    transform:translateY(0);\n  }\n\n}\n\n/* ===== FOOTER COLUMNS ===== */\n\n.footer-columns{\n  width:100%;\n  display:flex;\n  justify-content:space-between;\n  align-items:flex-start;\n  gap:20px;\n  flex-wrap:wrap;\n}\n\n/* ===== COLUMN ===== */\n\n.lux-column{\n  flex:1;\n  min-width:120px;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n}\n\n.lux-column h3{\n  font-size:18px;\n  margin-bottom:12px;\n  font-weight:800;\n  color:#fff;\n  transition:0.35s ease;\n}\n\n.lux-column h3:hover{\n  transform:translateY(-2px);\n}\n\n/* ===== SUB LINKS ===== */\n\n.lux-column a{\n  display:block;\n  color:#b8b8b8;\n  text-decoration:none;\n  margin-bottom:10px;\n  transition:0.35s ease;\n  font-size:16px;\n  font-weight:500;\n  letter-spacing:0.3px;\n}\n\n.lux-column a:hover{\n  color:#fff;\n  transform:translateX(4px);\n}\n\n/* ===== DIVIDER ===== */\n\n.footer-line{\n  width:100%;\n  height:1px;\n  background:#1b1b1b;\n  margin:22px 0 14px;\n}\n\n/* ===== FOOTER BOTTOM ===== */\n\n.footer-bottom{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:12px;\n}\n\n/* ===== SOCIAL ===== */\n\n.footer-social{\n  display:flex;\n  justify-content:center;\n  gap:12px;\n}\n\n/* ===== SOCIAL BOX ===== */\n\n.footer-social a{\n  width:38px;\n  height:38px;\n  border:1px solid #2a2a2a;\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  transition:0.4s ease;\n  background:#111;\n  animation:iconDrop 1s ease;\n}\n\n/* ===== ICON ANIMATION ===== */\n\n@keyframes iconDrop{\n\n  0%{\n    opacity:0;\n    transform:translateY(-40px) rotate(-180deg);\n  }\n\n  100%{\n    opacity:1;\n    transform:translateY(0) rotate(0deg);\n  }\n\n}\n\n.footer-social a:hover{\n  transform:translateY(-3px);\n  background:#1d1d1d;\n}\n\n/* ===== ICON ===== */\n\n.footer-social svg{\n  width:16px;\n  height:16px;\n  fill:#fff;\n}\n\n/* TikTok */\n.footer-social a:last-child svg{\n  width:18px;\n  height:18px;\n}\n\n/* ===== COPYRIGHT ===== */\n\n.footer-bottom p{\n  color:#a0a0a0;\n  font-size:14px;\n  font-weight:500;\n  letter-spacing:0.4px;\n  margin:0;\n}\n\n/* ===== MOBILE ===== */\n\n@media(max-width:768px){\n\n  .footer-columns{\n    flex-direction:row;\n    justify-content:space-between;\n    gap:10px;\n  }\n\n  .lux-column h3{\n    font-size:16px;\n  }\n\n  .lux-column a{\n    font-size:14px;\n  }\n\n}\n\n</style>",
