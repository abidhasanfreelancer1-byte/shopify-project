{%- comment -%}
  Best Selling Customers — premium social proof marquee section.
  Namespace: best-selling-customers (liquid, css, js)
  Add via Theme Editor → Product page → Add section → "Best Selling Customers"
{%- endcomment -%}

{{ 'best-selling-customers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'best-selling-customers.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign shadow_opacity = section.settings.card_shadow | divided_by: 100.0
  assign shadow_blur = section.settings.card_shadow | times: 0.4 | round
  assign shadow_y = section.settings.card_shadow | times: 0.08 | round
  if section.settings.card_shadow == 0
    assign card_shadow_value = 'none'
  else
    assign card_shadow_value = shadow_y | append: 'px ' | append: shadow_blur | append: 'px rgba(17, 17, 17, ' | append: shadow_opacity | append: ')'
  endif
-%}

{%- style -%}
  #BestSellingCustomers-{{ section.id }} {
    --bsc-heading-color: {{ section.settings.heading_color }};
    --bsc-text-color: {{ section.settings.text_color }};
    --bsc-bg-color: {{ section.settings.background_color }};
    --bsc-card-bg: {{ section.settings.card_background }};
    --bsc-card-radius: {{ section.settings.border_radius }}px;
    --bsc-card-gap: {{ section.settings.card_gap }}px;
    --bsc-card-shadow: {{ card_shadow_value }};
    --bsc-live-color: {{ section.settings.live_badge_color }};
    --bsc-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --bsc-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #BestSellingCustomers-{{ section.id }} {
      --bsc-padding-top: {{ section.settings.padding_top }}px;
      --bsc-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="BestSellingCustomers-{{ section.id }}"
  class="bsc-section"
  aria-label="{{ section.settings.heading | escape }}"
  data-bsc-slider
  data-auto-scroll-speed="{{ section.settings.auto_scroll_speed | divided_by: 100.0 }}"
  data-infinite-loop="{{ section.settings.enable_infinite_loop }}"
  {{ section.shopify_attributes }}
>
  <div class="bsc-section__inner page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.show_live_badge -%}
      <header class="bsc-header">
        {%- if section.settings.heading != blank or section.settings.show_live_badge -%}
          <div class="bsc-header__title-row">
            {%- if section.settings.heading != blank -%}
              <h2 class="bsc-header__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}

            {%- if section.settings.show_live_badge -%}
              <span class="bsc-header__live-badge">
                {{ section.settings.live_badge_text | escape }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="bsc-header__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="bsc-track-wrapper" data-bsc-track-wrapper>
        <div class="bsc-track" data-bsc-track role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'customer' -%}
              {%- liquid
                if block.settings.name != blank
                  assign photo_alt = block.settings.name | escape
                else
                  assign photo_alt = 'Customer photo'
                endif
              -%}
              <article
                class="bsc-card"
                role="listitem"
                {{ block.shopify_attributes }}
              >
                <div class="bsc-card__photo-wrap">
                  {%- if block.settings.photo != blank -%}
                    {{
                      block.settings.photo
                      | image_url: width: 440
                      | image_tag:
                        class: 'bsc-card__photo',
                        loading: 'lazy',
                        decoding: 'async',
                        widths: '110, 165, 220, 330, 440',
                        sizes: '(min-width: 750px) 220px, 72vw',
                        alt: photo_alt
                    }}
                  {%- else -%}
                    <div class="bsc-card__photo-placeholder" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                      </svg>
                    </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.name != blank -%}
                  <h3 class="bsc-card__name">{{ block.settings.name | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.location != blank -%}
                  <p class="bsc-card__location">{{ block.settings.location | escape }}</p>
                {%- endif -%}

                {%- if block.settings.show_verified_badge -%}
                  <span class="bsc-card__verified">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    {{ block.settings.verified_badge_text | escape }}
                  </span>
                {%- endif -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="bsc-header">
        <p class="bsc-header__subheading">
          Add customer blocks in the Theme Editor to display social proof cards.
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best Selling Customers",
  "tag": "section",
  "class": "section-best-selling-customers",
  "max_blocks": 32,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Best Selling in Dhaka"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Loved by Content Creators"
    },
    {
      "type": "checkbox",
      "id": "show_live_badge",
      "label": "Show LIVE badge",
      "default": true
    },
    {
      "type": "text",
      "id": "live_badge_text",
      "label": "LIVE badge text",
      "default": "🔴 LIVE"
    },
    {
      "type": "color",
      "id": "live_badge_color",
      "label": "LIVE badge color",
      "default": "#E53935"
    },
    {
      "type": "header",
      "content": "Colors & styling"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Card shadow intensity",
      "default": 35,
      "info": "0 = no shadow, 100 = strongest shadow."
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Gap between cards",
      "default": 16
    },
    {
      "type": "header",
      "content": "Slider behavior"
    },
    {
      "type": "range",
      "id": "auto_scroll_speed",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Auto scroll speed",
      "default": 35,
      "info": "0 = paused. Higher values scroll faster."
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_loop",
      "label": "Enable infinite loop",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "customer",
      "name": "Customer",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Customer location",
          "default": "City / District"
        },
        {
          "type": "checkbox",
          "id": "show_verified_badge",
          "label": "Show verified purchase badge",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_badge_text",
          "label": "Verified badge text",
          "default": "Verified Purchase"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Selling Customers",
      "blocks": [
        { "type": "customer" },
        { "type": "customer" },
        { "type": "customer" },
        { "type": "customer" },
        { "type": "customer" },
        { "type": "customer" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
