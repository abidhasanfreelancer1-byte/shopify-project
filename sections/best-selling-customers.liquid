{%- comment -%}
  Best Selling in Dhaka — Live Social Proof Slider
  Theme Editor → Product page → Add section → "Best Selling Customers"
  Add customer blocks to upload photos, names, and locations.
{%- endcomment -%}

{{ 'best-selling-customers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'best-selling-customers.js' | asset_url }}" defer="defer"></script>

{%- liquid
  if section.settings.auto_scroll_speed == 0
    assign scroll_step = 0
  else
    assign scroll_step = section.settings.auto_scroll_speed | divided_by: 20 | at_least: 1
  endif
  if section.settings.enable_infinite_loop
    assign loop_passes = 2
  else
    assign loop_passes = 1
  endif
-%}

{%- style -%}
  #BestSellingCustomers-{{ section.id }} {
    --bsc-bg: {{ section.settings.background_color }};
    --bsc-card: {{ section.settings.card_background }};
    --bsc-text: {{ section.settings.heading_color }};
    --bsc-muted: {{ section.settings.muted_text_color }};
    --bsc-live: {{ section.settings.live_badge_color }};
    --bsc-radius: {{ section.settings.border_radius }}px;
    --bsc-card-gap: {{ section.settings.card_gap }}px;
    --bsc-card-width: {{ section.settings.card_width }}px;
    --bsc-card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --bsc-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --bsc-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #BestSellingCustomers-{{ section.id }} {
      --bsc-padding-top: {{ section.settings.padding_top }}px;
      --bsc-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="BestSellingCustomers-{{ section.id }}"
  class="bsc-section"
  aria-label="{{ section.settings.heading | escape }}"
  data-bsc-slider
  data-infinite-loop="{{ section.settings.enable_infinite_loop }}"
  data-scroll-step="{{ scroll_step }}"
  data-scroll-interval="20"
  data-resume-delay="3000"
  {{ section.shopify_attributes }}
>
  {%- if section.settings.show_live_badge -%}
    <div class="bsc-corner-live">
      <span class="bsc-live-dot" aria-hidden="true"></span>
      {{ section.settings.live_badge_text | escape }}
    </div>
  {%- endif -%}

  <div class="bsc-header">
    {%- if section.settings.heading != blank -%}
      <h3 class="bsc-title">{{ section.settings.heading | escape }}</h3>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="bsc-subtitle">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="bsc-track-wrap">
      <div class="bsc-track" data-bsc-track role="list">
        {%- for pass in (1..loop_passes) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'customer' -%}
              {%- liquid
                if block.settings.name != blank
                  assign photo_alt = block.settings.name | escape
                else
                  assign photo_alt = 'Customer photo'
                endif
              -%}
              <article
                class="bsc-card"
                role="listitem"
                {% if pass == 2 %}aria-hidden="true"{% endif %}
                {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}
              >
                <div class="bsc-image-wrap">
                  {%- if block.settings.photo != blank -%}
                    {{
                      block.settings.photo
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        decoding: 'async',
                        widths: '145, 180, 360, 400',
                        sizes: '(max-width: 749px) 145px, 180px',
                        alt: photo_alt
                    }}
                  {%- else -%}
                    <div class="bsc-image-placeholder" aria-hidden="true">Photo</div>
                  {%- endif -%}
                </div>
                <div class="bsc-info">
                  {%- if block.settings.name != blank -%}
                    <p class="bsc-name">{{ block.settings.name | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.location != blank -%}
                    <p class="bsc-location">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"/>
                        <circle cx="12" cy="10" r="2.5"/>
                      </svg>
                      {{ block.settings.location | escape }}
                    </p>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <p class="bsc-empty">Add customer blocks in the Theme Editor to show social proof cards.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Best Selling Customers",
  "tag": "section",
  "class": "section-best-selling-customers",
  "max_blocks": 32,
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Best Selling in Dhaka"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Loved by Content Creators"
    },
    {
      "type": "checkbox",
      "id": "show_live_badge",
      "label": "Show LIVE badge",
      "default": true
    },
    {
      "type": "text",
      "id": "live_badge_text",
      "label": "LIVE badge text",
      "default": "Live"
    },
    {
      "type": "color",
      "id": "live_badge_color",
      "label": "LIVE dot color",
      "default": "#22C55E"
    },
    {
      "type": "header",
      "content": "Colors & layout"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Subheading & location color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAFAFA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Section border radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 120,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Card width (desktop)",
      "default": 180
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Card width (mobile)",
      "default": 145
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 14
    },
    {
      "type": "header",
      "content": "Slider behavior"
    },
    {
      "type": "range",
      "id": "auto_scroll_speed",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Auto scroll speed",
      "default": 20,
      "info": "0 = paused. Higher values scroll faster."
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_loop",
      "label": "Enable infinite loop",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "customer",
      "name": "Customer",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Customer location",
          "default": "Dhaka"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Selling Customers",
      "blocks": [
        { "type": "customer" },
        { "type": "customer" },
        { "type": "customer" },
        { "type": "customer" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
