        "custom_liquid": "<div id=\"shopify-countdown-wrapper-2515\">\n  <div class=\"countdown-header-2515\">GET 25% OFF TODAY</div>\n\n  <div class=\"countdown-timer-2515\">\n    <div class=\"time-box-2515\">\n      <span id=\"hours-2515\" class=\"time-value-2515\">11</span>\n      <span class=\"time-label-2515\">HRS</span>\n    </div>\n\n    <div class=\"separator-2515\">:</div>\n\n    <div class=\"time-box-2515\">\n      <span id=\"minutes-2515\" class=\"time-value-2515\">15</span>\n      <span class=\"time-label-2515\">MIN</span>\n    </div>\n\n    <div class=\"separator-2515\">:</div>\n\n    <div class=\"time-box-2515\">\n      <span id=\"seconds-2515\" class=\"time-value-2515\">00</span>\n      <span class=\"time-label-2515\">SEC</span>\n    </div>\n  </div>\n</div>\n\n<style>\n#shopify-countdown-wrapper-2515{\n  width:100%;\n  text-align:center;\n  margin:12px 0;\n  font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n}\n\n#shopify-countdown-wrapper-2515 .countdown-header-2515{\n  color:#111111;\n  font-size:22px;\n  font-weight:800;\n  letter-spacing:1px;\n  text-transform:uppercase;\n  margin-bottom:14px;\n}\n\n#shopify-countdown-wrapper-2515 .countdown-timer-2515{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:8px;\n  flex-wrap:nowrap;\n}\n\n#shopify-countdown-wrapper-2515 .time-box-2515{\n  min-width:45px;\n  padding:7px 10px;\n  background:#ffffff;\n  border:1px solid rgba(255,59,48,.25);\n  border-radius:14px;\n  box-shadow:\n    0 4px 20px rgba(0,0,0,.06),\n    0 0 18px rgba(255,59,48,.10);\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n}\n\n#shopify-countdown-wrapper-2515 .time-value-2515{\n  color:#ff3b30;\n  font-size:27px;\n  font-weight:700;\n  line-height:1;\n  font-variant-numeric:tabular-nums;\n}\n\n#shopify-countdown-wrapper-2515 .time-label-2515{\n  margin-top:2px;\n  color:#666666;\n  font-size:9px;\n  font-weight:700;\n  letter-spacing:1.2px;\n}\n\n#shopify-countdown-wrapper-2515 .separator-2515{\n  color:#ff3b30;\n  font-size:0px;\n  font-weight:700;\n  line-height:1;\n}\n\n@media (max-width:480px){\n\n  #shopify-countdown-wrapper-2515 .countdown-header-2515{\n    font-size:18px;\n  }\n\n  #shopify-countdown-wrapper-2515 .time-box-2515{\n    min-width:68px;\n    padding:10px;\n  }\n\n  #shopify-countdown-wrapper-2515 .time-value-2515{\n    font-size:26px;\n  }\n\n  #shopify-countdown-wrapper-2515 .separator-2515{\n    font-size:22px;\n  }\n}\n</style>\n\n<script>\n(function() {\n\n  const START_TIME = (11 * 60 * 60) + (15 * 60); // 11:15:00\n\n  let remainingSeconds = START_TIME;\n\n  const hoursEl = document.getElementById('hours-2515');\n  const minutesEl = document.getElementById('minutes-2515');\n  const secondsEl = document.getElementById('seconds-2515');\n\n  function updateTimer() {\n\n    const hours = Math.floor(remainingSeconds / 3600);\n    const minutes = Math.floor((remainingSeconds % 3600) / 60);\n    const seconds = remainingSeconds % 60;\n\n    hoursEl.textContent = String(hours).padStart(2, '0');\n    minutesEl.textContent = String(minutes).padStart(2, '0');\n    secondsEl.textContent = String(seconds).padStart(2, '0');\n\n    if (remainingSeconds <= 0) {\n      remainingSeconds = START_TIME;\n    } else {\n      remainingSeconds--;\n    }\n  }\n\n  updateTimer();\n  setInterval(updateTimer, 1000);\n\n})();\n</script>",
